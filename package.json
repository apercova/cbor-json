{
  "name": "cbor-json-converter",
  "version": "1.0.0",
  "private": true,
  "description": "A modern React application that converts CBOR files to JSON with a professional interface",
  "author": "apercova <https://github.com/apercova>",
  "license": "MIT",
  "keywords": [
    "cbor",
    "json",
    "converter",
    "react",
    "typescript",
    "codemirror"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/apercova/cbor-json.git"
  },
  "bugs": {
    "url": "https://github.com/apercova/cbor-json/issues"
  },
  "bin": {
    "cbor2json": "./bin/cbor2json.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.10.1",
    "@codemirror/view": "^6.38.1",
    "@types/file-saver": "^2.0.5",
    "@types/node": "^16.18.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@uiw/react-codemirror": "^4.25.1",
    "cbor-js": "^0.1.0",
    "file-saver": "^2.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.0"
  },
  "scripts": {
    "start": "HOST=127.0.0.1 react-scripts start",
    "build": "INLINE_RUNTIME_CHUNK=false GENERATE_SOURCEMAP=false react-scripts build && node scripts/inject-csp.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "serve": "npx serve -s build",
    "cbor2json": "node bin/cbor2json.js",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "analyze": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "homepage": "https://apercova.github.io/cbor-json",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/cbor-js": "^0.1.1",
    "gh-pages": "^6.1.1"
  }
}
